  <property name="styleSheet">
   <string notr="true">* {
	background-color: rgb(222, 221, 218); 
	color: black;
}

QPushButton[class=&quot;button-green&quot;] {
	border: 1px solid #0a5128;
    border-radius: 15px;
    padding: 0px 10px 0px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #1ebd5d, 
                                stop:1 #107f3f);
    color: #FFF;
    font: 10pt &quot;Inter SemiBold&quot;;
}

QPushButton[class=&quot;button-green&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #2ecc71, 
                                stop:1 #27AE60);
}

QPushButton[class=&quot;button-green&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #0b572a, 
                                stop:1 #129046); 
}

QPushButton[class=&quot;button-green&quot;]:disabled {
    background: #A5D6A7;
    color: #E8F5E9;
    opacity: 0.6;
}

*[class=&quot;button-normal&quot;] {
	font: 10pt &quot;Inter&quot;;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #ffffff, 
                                stop:1 #d8ecf6);
	color: black;
	border-radius: 15px;
	border: 1px solid rgb(154, 153, 150);
}

*[class=&quot;button-normal&quot;]:hover {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #ffffff, 
                                stop:1 #f2f6f8);
}

*[class=&quot;button-normal&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #dce5e9, 
                                stop:1 #ffffff);
}

*[class=&quot;button-normal&quot;]:disabled {
	background: #f5f5f5;
	border: 1px solid #dcdcdc;
	color: #aeaeae;
}

QLabel:disabled {
	color: #aeaeae;
}

*[class=&quot;input-field&quot;] {
	background-color: transparent;
}

*[class=&quot;input-field&quot;] QLineEdit {
	background-color: #ffffff;
	border: 1px solid #999;
	border-left: none;
	border-top-right-radius: 15px;
	border-bottom-right-radius: 15px;
	padding: 0px 8px;
	color: black;
}

*[class=&quot;input-field&quot;] QLabel {
	background-color: rgb(192, 191, 188);
	border-left: 1px solid #999;
	border-top: 1px solid #999;
	border-bottom: 1px solid #999;
	border-right: none;
	border-top-left-radius: 15px;
	border-bottom-left-radius: 15px;
	padding-left: 8px;
	color: black;
}

QProgressBar {
	border-radius: 10px;
	background-color: white;
}

QProgressBar::chunk {
	background-color: #007BFF;
	border-radius: 10px;
}

QComboBox {
    border: 1px solid #999;
    border-left: none;
    padding: 0px 10px;
    background-color: #ffffff;
    color: #333333;
    font: 10pt &quot;Inter Medium&quot;;
    selection-background-color: #7eb4d7;
	border-top-right-radius: 15px;
	border-bottom-right-radius: 15px;
}

QComboBox:focus, QLineEdit:focus {
    border: 1px solid #007BFF;
}

QComboBox:hover, QLineEdit:hover {
    border: 1px solid #3498db;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    /* Match the 15px border-radius of the main control */
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

QComboBox::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    border: none;
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: white !important;
    border: 1px solid #999;
    selection-background-color: #7eb4d7;
    selection-color: #ffffff;
    outline: 0; /* Removes the ugly dotted focus border */
}

QComboBox QAbstractItemView::item {
    padding: 0px 15px;
    border-radius: 4px;
    color: #333333;
}

/* Hover state for items inside the dropdown */
QComboBox QAbstractItemView::item:hover {
    background-color: #7eb4d7;
    color: #ffffff;
}

QScrollArea { 
    border: none;
    border-radius: 20px;
	background-color: rgb(246, 245, 244);
}

/* 2. THE VIEWPORT (Crucial for transparency/backgrounds) */
QScrollArea QWidget #qt_scrollarea_viewport {
    background: transparent;
    border-radius: 20px;
}

/* 3. VERTICAL SCROLLBAR */
QScrollBar:vertical {
    border: none;
    background: #ffffff;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #7a7a7a;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #574939;
}

/* 4. HORIZONTAL SCROLLBAR */
QScrollBar:horizontal {
    border: none;
    background: #ffffff;
    height: 10px; /* Note: height, not width */
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #7a7a7a;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #574939;
}

/* 5. REMOVE BUTTONS &amp; TRACK BACKGROUNDS */
/* This handles both horizontal and vertical arrows/tracks */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 6. THE CORNER WIDGET 
   (The small square where both bars meet) */
QScrollArea QWidget #qt_scrollarea_corner {
    background: transparent;
    border: none;
}</string>

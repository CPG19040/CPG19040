}

QDialog {
    background: transparent;
}


#frame_header {
    background-color: #deddda;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border: 1px solid #7a7a7a;
    border-bottom: none;
}

#label_windowTitle {
    background: transparent;
    font: 10pt &quot;Inter SemiBold&quot;;
    color: #111827;
}

#widget_window_buttons {
    background: transparent;
}

#btnMinimize {
    border-radius: 12px;
    background-color: transparent;
}

#btnMinimize:hover {
    background-color: #f8e45c;
}

#btnClose {
    border-radius: 12px;
    background-color: transparent;
}

#btnClose:hover {
    background-color: #f66151;
}


#widget_body {
    background-color: #deddda;
    border: 1px solid #7a7a7a;
    border-top: none;
}


*[class=&quot;input-field&quot;] {
    background-color: transparent;
}

*[class=&quot;input-field&quot;] QLineEdit {
    background-color: #ffffff;
    border: 1px solid #999;
    border-left: none;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    padding: 0px 8px;
    color: #1f2937;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:hover {
    border: 1px solid #3b82f6;
}

*[class=&quot;input-field&quot;] QLineEdit:disabled {
    background-color: #f3f4f6;
    border: none;
    color: #999;
}

*[class=&quot;input-field&quot;] QLabel {
    background-color: #d2d2d2;
    border-left: 1px solid #999;
    border-top: 1px solid #999;
    border-bottom: 1px solid #999;
    border-right: none;
    border-top-left-radius: 18px;
    border-bottom-left-radius: 18px;
    padding-left: 8px;
    color: #000000;
}

*[class=&quot;input-field&quot;] QLabel:disabled {
    color: #999;
    border: none;
}



*[class=&quot;input-field&quot;] QComboBox {
    border: 1px solid #999;
    border-left: none;
    padding: 0px 10px;
    background-color: #ffffff;
    color: #1f2937;
    font: 10pt &quot;Inter Medium&quot;;
    selection-background-color: #bfdbfe;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
}

QComboBox:focus {
    border: 1px solid #2563eb;
}

QComboBox:hover {
    border: 1px solid #3b82f6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

QComboBox::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    border: none;
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff !important;
    border: 1px solid #999;
    selection-background-color: #bfdbfe;
    selection-color: #111827;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    padding: 0px 15px;
    border-radius: 4px;
    color: #1f2937;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #bfdbfe;
    color: #111827;
}

QComboBox:disabled {
    background-color: #f3f4f6;
    border: none;
    color: #999;
}

QComboBox::drop-down:disabled {
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: transparent;
}

QComboBox::down-arrow:disabled {
    image: url(:/Images/Images/caret-down-disabled.png);
}



QPushButton[class=&quot;button-green&quot;] {
    border: 1px solid #0a5128;
    border-radius: 15px;
    padding: 0px 10px 0px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1ebd5d, stop:1 #107f3f);
    color: #FFF;
    font: 10pt &quot;Inter SemiBold&quot;;
}

QPushButton[class=&quot;button-green&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ecc71, stop:1 #27AE60);
}

QPushButton[class=&quot;button-green&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0b572a, stop:1 #129046);
}

QPushButton[class=&quot;button-green&quot;]:disabled {
    background: #A5D6A7;
    color: #E8F5E9;
    opacity: 0.6;
}

QPushButton[class=&quot;button-normal&quot;] {
    color: #000000;
    font: 10pt &quot;Inter&quot;;
    border: 1px solid #9a9996;
    border-radius: 15px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #d8ecf6);
}

QPushButton[class=&quot;button-normal&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f2f6f8);
}

QPushButton[class=&quot;button-normal&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #dce5e9, stop:1 #ffffff);
}

QPushButton[class=&quot;button-normal&quot;]:disabled {
    color: #aeaeae;
    border: 1px solid #dcdcdc;
    background: #f5f5f5;
}



QProgressBar {
    border-radius: 10px;
    background-color: white;
}

QProgressBar::chunk {
    background-color: #007BFF;
    border-radius: 10px;
}



QRadioButton {
    color: #1f2937;
    spacing: 8px;
    padding: 0px 10px;
    background: transparent;
    font: 10pt &quot;Inter&quot;;
}

QRadioButton::indicator {
    background: #ffffff;
    border: 2px solid #999;
    min-width: 14px;
    min-height: 14px;
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    border-color: #93c5fd;
    background-color: #2563eb;
}



QScrollBar:vertical {
    border: none;
    background: #ffffff;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #7a7a7a;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #574939;
}

QScrollBar:horizontal {
    border: none;
    background: #ffffff;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #7a7a7a;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #574939;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


#line_1 {

  <property name="styleSheet">
   <string notr="true">* {
	background-color: rgb(222, 221, 218); 
	color: black;
}

*[class=&quot;button-normal&quot;] {
	font: 10pt &quot;Inter&quot;;
	background-color: #e7e7e7;
	color: black;
	border-radius: 15px;
	border: 1px solid rgb(154, 153, 150);
}

*[class=&quot;button-normal&quot;]:hover {
	background-color: white;
}

*[class=&quot;button-normal&quot;]:disabled {
	background-color: #f5f5f5;
	border: 1px solid #dcdcdc;
	color: #aeaeae;
}

QLabel:disabled {
	color: #aaaaaa;
}

QProgressBar {
	border-radius: 10px;
	background-color: white;
}

QProgressBar::chunk {
	background-color: #007BFF;
	border-radius: 10px;
}

QPushButton:disabled, QLineEdit:disabled, QComboBox:disabled {
    background-color: #d5d6d7;
    color: #7f8c8d;
    border: 1px solid #95a5a6;
}

#widget_CSV:disabled, #widget_stud_info:disabled, QComboBox:disabled { 
	color: rgba(0, 0, 0, 50); 
	background-color: rgba(200, 200, 200, 0); 
}

QLineEdit {
	background-color: rgb(255, 255, 255); 
	border-radius: 15px;
	border: 1px solid #999;
	padding: 0px 15px;
}

QComboBox {
    border: 1px solid #999;
    border-radius: 15px; /* Fully rounded pills */
    padding: 0px 15px 0px;
    background-color: #ffffff;
    color: #333333;
    font: 10pt &quot;Inter Medium&quot;; /* Consolidated font settings */
    selection-background-color: #7eb4d7;
}

QComboBox:focus, QLineEdit:focus {
    border: 1px solid #007BFF;
}

QComboBox:hover, QLineEdit:hover {
    border: 1px solid #3498db;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    /* Match the 15px border-radius of the main control */
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

QComboBox::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    border: none;
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: white !important;
    border: 1px solid #999;
    selection-background-color: #7eb4d7;
    selection-color: #ffffff;
    outline: 0; /* Removes the ugly dotted focus border */
}

QComboBox QAbstractItemView::item {
    padding: 0px 15px;
    border-radius: 4px;
    color: #333333;
}

/* Hover state for items inside the dropdown */
QComboBox QAbstractItemView::item:hover {
    background-color: #7eb4d7;
    color: #ffffff;
}

QComboBox:disabled, QLineEdit:disabled {
    background-color: #f5f5f5;
    border: 1px solid #dcdcdc;
    color: #aaaaaa;
}

QComboBox::drop-down:disabled {
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: transparent;
}

QComboBox::down-arrow:disabled {
    image: url(:/Images/Images/caret-down-disabled.png);
}

QSpinBox {
	font: 10pt &quot;Inter Medium&quot;;
    height: 30px;
    border: 1px solid #999;
    border-radius: 15px;
    padding: 0px 5px 0px;
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #7eb4d7;
}

QSpinBox:focus {
    border: 1px solid #007BFF;
}

QSpinBox:hover {
    border: 1px solid #3498db;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 8px;
    height: 8px;
    border-top-right-radius: 15px;
    padding: 6px 10px 6px 2px;
	color: rgb(119, 118, 123);
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
    border-bottom-right-radius: 15px;
    padding: 6px 10px 6px 2px;
	color: rgb(119, 118, 123);
}

QSpinBox::up-arrow {
    image: url(:/Images/Images/caret-up.png);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    width: 8px;
    height: 8px;
}</string>

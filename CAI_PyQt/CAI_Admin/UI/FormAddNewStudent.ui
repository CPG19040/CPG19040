   <item>
    <widget class="QWidget" name="widget_body" native="true">
     <property name="styleSheet">
      <string notr="true">#widget_body {
	background-color: #deddda;
	border: 1px solid #7a7a7a;
	border-top: none;
}

*[class=&quot;button-normal&quot;] {
	font: 10pt &quot;Inter&quot;;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #ffffff, 
                                stop:1 #d8ecf6);
	color: black;
	border-radius: 15px;
	border: 1px solid rgb(154, 153, 150);
}

*[class=&quot;button-normal&quot;]:hover {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #ffffff, 
                                stop:1 #f2f6f8);
}

*[class=&quot;button-normal&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #dce5e9, 
                                stop:1 #ffffff);
}

*[class=&quot;button-normal&quot;]:disabled {
	background: #f5f5f5;
	border: 1px solid #dcdcdc;
	color: #aeaeae;
}

QPushButton[class=&quot;button-green&quot;] {
	border: 1px solid #0a5128;
    border-radius: 15px;
    padding: 0px 10px 0px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #1ebd5d, 
                                stop:1 #107f3f);
    color: #FFF;
    font: 10pt &quot;Inter SemiBold&quot;;
}

QPushButton[class=&quot;button-green&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #2ecc71, 
                                stop:1 #27AE60);
}

QPushButton[class=&quot;button-green&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #0b572a, 
                                stop:1 #129046); 
}

QPushButton[class=&quot;button-green&quot;]:disabled {
    background: #A5D6A7;
    color: #E8F5E9;
    opacity: 0.6;
}

*[class=&quot;input-field&quot;] {
	background-color: transparent;
}

*[class=&quot;input-field&quot;] QLineEdit {
	background-color: #ffffff;
	border: 1px solid #999;
	border-left: none;
	border-top-right-radius: 18px;
	border-bottom-right-radius: 18px;
	padding: 0px 8px;
	color: black;
}

*[class=&quot;input-field&quot;] QLabel {
	background-color: #d2d2d2;
	border-left: 1px solid #999;
	border-top: 1px solid #999;
	border-bottom: 1px solid #999;
	border-right: none;
	border-top-left-radius: 18px;
	border-bottom-left-radius: 18px;
	padding-left: 8px;
	color: black;
}

QLabel:disabled {
	color: #aaaaaa;
	border: none;
}

QProgressBar {
	border-radius: 10px;
	background-color: white;
}

QProgressBar::chunk {
	background-color: #007BFF;
	border-radius: 10px;
}

*[class=&quot;input-field&quot;] QPushButton:disabled, 
*[class=&quot;input-field&quot;] QLineEdit:disabled, 
*[class=&quot;input-field&quot;] QComboBox:disabled  {
    background-color: #f5f5f5;
	border: none;
	color: #aeaeae;
}

QRadioButton {
	color: black;
	spacing: 8px;
	padding: 0px 10px;
	background: transparent;
	font: 10pt &quot;Inter&quot;;
}

QRadioButton::indicator {
	background: #FFF;
	border: 2px solid #999;
	min-width: 14px;
	min-height: 14px;
	border-radius: 7px;
}

QRadioButton::indicator:checked {
	border-color: #7dd6ff;
	background-color: #007bff;
}

QComboBox {
    border: 1px solid #999;
    border-left: none;
    padding: 0px 10px;
    background-color: #ffffff;
    color: #333333;
    font: 10pt &quot;Inter Medium&quot;;
    selection-background-color: #7eb4d7;
	border-top-right-radius: 18px;
	border-bottom-right-radius: 18px;
}

QComboBox:focus, QLineEdit:focus {
    border: 1px solid #007BFF;
}

QComboBox:hover, QLineEdit:hover {
    border: 1px solid #3498db;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

QComboBox::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    border: none;
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: white !important;
    border: 1px solid #999;
    selection-background-color: #7eb4d7;
    selection-color: #ffffff;
    outline: 0; /* Removes the ugly dotted focus border */
}

QComboBox QAbstractItemView::item {
    padding: 0px 15px;
    border-radius: 4px;
    color: #333333;
}

/* Hover state for items inside the dropdown */
QComboBox QAbstractItemView::item:hover {
    background-color: #7eb4d7;
    color: #ffffff;
}

QComboBox:disabled {
    background-color: #f5f5f5;
    border: none;
    color: #aaaaaa;
}

QComboBox::drop-down:disabled {
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: transparent;
}

QComboBox::down-arrow:disabled {
    image: url(:/Images/Images/caret-down-disabled.png);
}

QSpinBox {
	font: 10pt &quot;Inter Medium&quot;;
    height: 30px;
    border: 1px solid #999;
    border-radius: 15px;
    padding: 0px 5px 0px;
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #7eb4d7;
}

QSpinBox:focus {
    border: 1px solid #007BFF;
}

QSpinBox:hover {
    border: 1px solid #3498db;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 8px;
    height: 8px;
    border-top-right-radius: 15px;
    padding: 6px 10px 6px 2px;
	color: rgb(119, 118, 123);
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
    border-bottom-right-radius: 15px;
    padding: 6px 10px 6px 2px;
	color: rgb(119, 118, 123);
}

QSpinBox::up-arrow {
    image: url(:/Images/Images/caret-up.png);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    width: 8px;
    height: 8px;
}</string>

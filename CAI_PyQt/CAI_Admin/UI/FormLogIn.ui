    <item>
     <widget class="QWidget" name="widget_body" native="true">
      <property name="styleSheet">
       <string notr="true">#widget_body {
	background-color: #3d3d3d;
	border: 1px solid #7a7a7a;
	border-top: none;
}

*[class=&quot;input-field&quot;] {
	background-color: transparent;
}

*[class=&quot;input-field&quot;] QLabel {
	color: #4a4a4a;
	background-color: rgb(192, 191, 188);
	border: 1px solid #999;
	border-right: none;
	border-top-left-radius: 18px;
	border-bottom-left-radius: 18px;
	padding-left: 8px;
}

*[class=&quot;input-field&quot;] QLineEdit {
	background-color: rgb(234, 234, 234);
	border: 1px solid #ABABAB;
	border-left: none;
	border-top-right-radius: 18px;
	border-bottom-right-radius: 18px;
	padding: 0px 8px;
	color: rgb(36, 31, 49);
}

*[class=&quot;input-field&quot;] QLineEdit:hover {
	border: 1px solid #3498db;
}

*[class=&quot;input-field&quot;] QLineEdit:focus {
	border: 1px solid #007BFF;
}

#btnLogin {
	border-radius: 20px;
	background: #FF1595;
	color: white;
	font-family: 'Inter Medium'; 
	font-size: 11pt;
}

#btnLogin:hover {
 	background: #ED5AB3;
}</string>

  <property name="styleSheet">
   <string notr="true">* {
    color: #000000;
    font: 10pt &quot;Inter&quot;;
}

QLabel:disabled {
    color: #999;
}

#QuizCreatorDialog {
    background: transparent;
}


#frame_header {
    background-color: #deddda;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border: 1px solid #7a7a7a;
    border-bottom: none;
}

#label_windowTitle {
    background: transparent;
    font: 10pt &quot;Inter SemiBold&quot;;
    color: #111827;
}

#widget_window_buttons {
    background: transparent;
}

#btnMinimize {
    border-radius: 12px;
    background-color: transparent;
}

#btnMinimize:hover {
    background-color: #f8e45c;
}

#btnClose {
    border-radius: 12px;
    background-color: transparent;
}

#btnClose:hover {
    background-color: #f66151;
}


#btnMaximize {
    border-radius: 12px;
    background-color: transparent;
}

#btnMaximize:hover {
    background-color: #3bca5c;
}

#widget_body {
    background-color: #deddda;
    border: 1px solid #7a7a7a;
    border-top: none;
}

QLabel[class=&quot;accented-labels&quot;] {
    background-color: rgb(255, 255, 255);
    padding: 0px 10px 0px;
    border-radius: 10px;
}


QPushButton[class=&quot;button-green&quot;] {
    border: 1px solid #0a5128;
    border-radius: 15px;
    padding: 0px 10px 0px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1ebd5d, stop:1 #107f3f);
    color: #FFF;
    font: 10pt &quot;Inter SemiBold&quot;;
}

QPushButton[class=&quot;button-green&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ecc71, stop:1 #27AE60);
}

QPushButton[class=&quot;button-green&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0b572a, stop:1 #129046);
}

QPushButton[class=&quot;button-green&quot;]:disabled {
    background: #a7f3d0;
    border: 1px solid #6ee7b7;
    color: #098f69;
}

QPushButton[class=&quot;button-normal&quot;] {
    color: #000000;
    font: 10pt &quot;Inter&quot;;
    border: 1px solid #9a9996;
    border-radius: 15px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #d8ecf6);
}

QPushButton[class=&quot;button-normal&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f2f6f8);
}

QPushButton[class=&quot;button-normal&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #dce5e9, stop:1 #ffffff);
}

QPushButton[class=&quot;button-normal&quot;]:disabled {
    color: #aeaeae;
    border: 1px solid #dcdcdc;
    background: #f5f5f5;
}



QScrollBar:vertical {
    border: none;
    background: #ffffff;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #7a7a7a;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #574939;
}

QScrollBar:horizontal {
    border: none;
    background: #ffffff;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #7a7a7a;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #574939;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}



QToolTip {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    padding: 6px 10px;
    border-radius: 6px;
    font: 9pt &quot;Inter&quot;;
}


#btn_save {
    border: none;
    background: transparent;
}

#btn_save:hover {
    background-color: rgb(255, 255, 255);
    border-radius: 5px;
}


#widget_difficulty_toggle QPushButton {
    border: 1px solid #9ca3af;
    padding: 5px 10px;
    font: 10pt &quot;Inter&quot;;
    background-color: #f3f4f6;
    color: #1f2937;
}

#widget_difficulty_toggle QPushButton:hover {
    background-color: #e5e7eb;
}

#widget_difficulty_toggle QPushButton:disabled {
    background-color: #f3f4f6;
    border: 1px solid #e5e7eb;
    color: #9ca3af;
}

QPushButton#btnEasy {
    border-top-left-radius: 15px;
    border-bottom-left-radius: 15px;
    border-right: none;
}

QPushButton#btnAverage {
    border-radius: 0px;
    border-right: none;
}

QPushButton#btnHard {
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

QPushButton#btnEasy:checked {
    background-color: #86efac;
    border: 2px solid #22c55e;
    color: #14532d;
}

QPushButton#btnAverage:checked {
    background-color: #fef08a;
    border: 2px solid #eab308;
    color: #713f12;
}

QPushButton#btnHard:checked {
    background-color: #fca5a5;
    border: 2px solid #ef4444;
    color: #7f1d1d;
}

QPushButton#btnEasy:disabled,
QPushButton#btnAverage:disabled {
    border-right: none;
}

QPushButton#btnEasy:checked:disabled {
    background-color: #dcfce7;
    border: 2px solid #bbf7d0;
    border-right: none;
    color: #86efac;
}

QPushButton#btnAverage:checked:disabled {
    background-color: #fefce8;
    border: 2px solid #fef08a;
    border-right: none;
    color: #fde047;
}

QPushButton#btnHard:checked:disabled {
    background-color: #fee2e2;
    border: 2px solid #fecaca;
    color: #fca5a5;
}


QComboBox[class=&quot;combobox-main&quot;],
QSpinBox,
QDoubleSpinBox,
QDateEdit {
    height: 30px;
    padding: 0px 5px 0px 10px;
    color: #333333;
    font: 10pt &quot;Inter SemiBold&quot;;
    background-color: #ffffff;
    border: 1px solid #999999;
    border-radius: 15px;
    selection-background-color: #7eb4d7;
}

QComboBox[class=&quot;combobox-main&quot;]:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border: 1px solid #3498db;
}

QComboBox[class=&quot;combobox-main&quot;]:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border: 1px solid #007bff;
}

QComboBox[class=&quot;combobox-main&quot;]:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border: 1px solid #007BFF;
}

QComboBox[class=&quot;combobox-main&quot;]:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled {
    border: none;
    color: #999;
}

/* Dropdown Subcontrols */
QComboBox::drop-down,
QDoubleSpinBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 8px;
    height: 8px;
    padding: 6px 10px 6px 2px;
    color: #77767b;
    border-top-right-radius: 15px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
    padding: 6px 10px 6px 2px;
    color: #77767b;
    border-bottom-right-radius: 15px;
}

/* Control Arrows */
QComboBox::down-arrow,
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow {
    image: url(:/Images/Images/caret-down.png);
    width: 8px;
    height: 8px;
    border: none;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow {
    image: url(:/Images/Images/caret-up.png);
    width: 8px;
    height: 8px;
}

QComboBox::down-arrow:disabled,
QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled,
QDateEdit::down-arrow:disabled {
    image: url(:/Images/Images/caret-down-disabled.png);
    width: 8px;
    height: 8px;
    border: none;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled,
QDateEdit::up-arrow:disabled {
    image: url(:/Images/Images/caret-up-disabled.png);
    width: 8px;
    height: 8px;
}

/* ComboBox Item View Popup */
QComboBox QAbstractItemView {
    outline: 0;
    border: 1px solid #999999;
    background-color: #ffffff !important;
    selection-color: #ffffff;
    selection-background-color: #7eb4d7;
}

QComboBox QAbstractItemView::item {
    padding-left: 10px;
    color: #333333;
    border-radius: 4px;
}

QComboBox[class=&quot;combobox-main&quot;] QAbstractItemView::item:hover {
    color: #ffffff;
    background-color: #7eb4d7;
}

QScrollArea {
    border: none;
    border-radius: 20px;
    background-color: #deddda;
}

QScrollArea QWidget #qt_scrollarea_corner {
    background: transparent;
    border: none;
}

#scrollArea_id #scrollAreaWidgetContents_1,
#scrollArea_mc #scrollAreaWidgetContents_2,
#scrollArea_tf #scrollAreaWidgetContents_3 {
    background-color: #c8c7c5;
    border-radius: 10px;
}

#line_1,
#line_2,
#line_3 {
    background-color: #deddda;
}


QCheckBox {
    background-color: transparent;
    padding: 5px 10px;
    color: #1f2937;
    font: 10pt &quot;Inter&quot;;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #ffffff;
    border: 2px solid #9ca3af;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url(:/Images/Images/check.png);
}

QCheckBox::indicator:disabled {
    background-color: #f3f4f6;
    border: 2px solid #d1d5db;
    image: none;
}

QCheckBox:disabled {
    color: #9ca3af;
}</string>

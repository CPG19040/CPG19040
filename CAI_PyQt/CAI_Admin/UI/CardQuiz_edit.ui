  <property name="styleSheet">
   <string notr="true">* {
    font: 11pt &quot;Inter&quot;;
    color: #1f2937;
}

#CardQuiz_edit {
    background: transparent;
    color: #1f2937;
}

#Card {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
}

#frame_2,
#widget_img {
    border: none;
}

QLabel {
    color: #374151;
}

QToolTip {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    padding: 4px 6px;
    border-radius: 6px;
    font: 10pt &quot;Inter&quot;;
}

#widget_header {
    background-color: #ffffff;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

#label_itemno {
    font: 10pt &quot;Inter SemiBold&quot;;
    color: #1e40af;
}

#btn_delete {
    background-color: transparent;
    color: #ef4444;
    font: 12pt &quot;Inter SemiBold&quot;;
    border-radius: 15px;
}

#btn_delete:hover {
    color: #ffffff;
    background-color: #ef4444;
    border: 1px solid #ef4444;
}

#btn_q_image {
    background-color: #ffffff;
    border: none;
    border-radius: 8px;
}

#btn_q_image:hover {
    background-color: #eff6ff;
    border: none;
}

#btn_upload_img {
    border: none;
    color: #2563eb;
    background-color: transparent;
    margin: 0px 20px;
    font: 10pt &quot;Inter Medium&quot;;
}

#btn_upload_img:hover {
    color: #1d4ed8;
}

#txt_question {
    background-color: #ffffff;
    border-radius: 15px;
    padding: 8px 10px;
    border: 1px solid #9ca3af;
    color: #1f2937;
}

#txt_question:hover {
    border: 1px solid #3b82f6;
}

#txt_question:focus {
    border: 1px solid #2563eb;
}</string>
